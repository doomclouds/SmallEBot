<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- RZ10012: design-time only, MudBlazor components resolve at build -->
    <NoWarn>$(NoWarn);RZ10012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SmallEBot.Core/SmallEBot.Core.csproj" />
    <ProjectReference Include="../SmallEBot.Domain/SmallEBot.Domain.csproj" />
    <ProjectReference Include="../SmallEBot.Application/SmallEBot.Application.csproj" />
    <ProjectReference Include="../SmallEBot.Application.Contracts/SmallEBot.Application.Contracts.csproj" />
    <ProjectReference Include="../SmallEBot.Infrastructure/SmallEBot.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Anthropic" Version="1.0.0-rc3" />
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Markdig" Version="0.45.0" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".agents\.sys.mcp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- System skills: under VFS at runtime (.agents/vfs/sys.skills/) -->
    <Content Include=".agents\vfs\sys.skills\**\*">
      <LinkBase>.agents\vfs\sys.skills</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Python\python.exe" />
    <Content Update="python.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="python.exe" />
    <Content Include=".agents\vfs\.gitkeep">
      <LinkBase>.agents\sys.skills\</LinkBase>
    </Content>
    <Content Include=".agents\vfs\python.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
