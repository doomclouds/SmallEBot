@using SmallEBot.Components.Chat.Orchestration
@using SmallEBot.Core.Models
@* Popover for @ (files) or / (skills) selection. Shown above the input. *@
@inject IJSRuntime JS

<MudMenu Open="@Orchestrator.IsPopoverOpen"
         OpenChanged="@OnOpenChanged"
         AnchorOrigin="Origin.TopCenter"
         TransformOrigin="Origin.BottomCenter"
         Dense="true"
         Style="margin-bottom: 4px;">
    <ActivatorContent>
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 1px;"></div>
    </ActivatorContent>
    <ChildContent>
        <MudPaper Outlined="true" Class="pa-1" Style="min-width: 220px;">
            <div id="smallebot-attachment-popover-scroll"
                 tabindex="0"
                 role="listbox"
                 aria-label="@(Orchestrator.PopoverKind == "file" ? "Workspace files" : "Skills")"
                 style="max-height: 240px; overflow-y: auto; outline: none;"
                 @onkeydown="OnKeyDown">
                @if (Orchestrator.PopoverKind == "file")
                {
                    @if (FilteredPaths.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-3 text-secondary">@(Orchestrator.FilePaths.Count == 0 ? "No files with allowed extensions." : "No matching files.")</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true" SelectedValue="@GetSelectedValue()" Style="overflow: visible;">
                            @foreach (var path in FilteredPaths)
                            {
                                <MudListItem T="string" Value="@path" OnClick="@(() => SelectItem(path))">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="me-2" />
                                    @path
                                </MudListItem>
                            }
                        </MudList>
                    }
                }
                else
                {
                    @if (FilteredSkills.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-3 text-secondary">@(Orchestrator.Skills.Count == 0 ? "No skills available." : "No matching skills.")</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true" SelectedValue="@GetSelectedValue()" Style="overflow: visible;">
                            @foreach (var skill in FilteredSkills)
                            {
                                <MudListItem T="string" Value="@skill.Id" OnClick="@(() => SelectItem(skill.Id))">
                                    <MudText Typo="Typo.body2">@skill.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="text-secondary ms-1">@skill.Id</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    }
                }
            </div>
        </MudPaper>
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public InputOrchestrator Orchestrator { get; set; } = default!;

    private int _selectedIndex;
    private bool _openPrev;

    private IReadOnlyList<string> FilteredPaths => string.IsNullOrEmpty(Orchestrator.PopoverFilter)
        ? Orchestrator.FilePaths
        : Orchestrator.FilePaths.Where(p => p.Contains(Orchestrator.PopoverFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<SkillMetadata> FilteredSkills => string.IsNullOrEmpty(Orchestrator.PopoverFilter)
        ? Orchestrator.Skills
        : Orchestrator.Skills.Where(s => s.Id.Contains(Orchestrator.PopoverFilter, StringComparison.OrdinalIgnoreCase) || s.Name.Contains(Orchestrator.PopoverFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private int ItemCount => Orchestrator.PopoverKind == "file" ? FilteredPaths.Count : FilteredSkills.Count;

    private void OnOpenChanged(bool open)
    {
        if (!open)
            Orchestrator.ClosePopover();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Orchestrator.IsPopoverOpen && !_openPrev)
            _selectedIndex = 0;
        if (Orchestrator.IsPopoverOpen && ItemCount > 0)
            _selectedIndex = Math.Clamp(_selectedIndex, 0, ItemCount - 1);
        _openPrev = Orchestrator.IsPopoverOpen;
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Orchestrator.IsPopoverOpen && ItemCount > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("SmallEBot.scrollAttachmentPopoverToIndex", "smallebot-attachment-popover-scroll", _selectedIndex);
            }
            catch { /* ignore */ }
        }
    }

    public async Task HandleKeyFromInputAsync(string key)
    {
        if (ItemCount == 0) return;
        if (key == "ArrowDown")
        {
            _selectedIndex = Math.Min(ItemCount - 1, _selectedIndex + 1);
            StateHasChanged();
            return;
        }
        if (key == "ArrowUp")
        {
            _selectedIndex = Math.Max(0, _selectedIndex - 1);
            StateHasChanged();
            return;
        }
        if (key == "Enter")
        {
            var value = GetSelectedValue();
            if (value != null)
                Orchestrator.SelectAttachment(value);
            return;
        }
        if (key == "Escape")
            Orchestrator.ClosePopover();
    }

    private async Task OnKeyDown(KeyboardEventArgs e) => await HandleKeyFromInputAsync(e.Key);

    private string? GetSelectedValue()
    {
        if (_selectedIndex < 0 || _selectedIndex >= ItemCount) return null;
        return Orchestrator.PopoverKind == "file" ? FilteredPaths[_selectedIndex] : FilteredSkills[_selectedIndex].Id;
    }

    private void SelectItem(string value) => Orchestrator.SelectAttachment(value);
}
