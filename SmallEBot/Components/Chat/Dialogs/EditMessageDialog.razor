@* Edit message dialog: uses InputOrchestrator + add buttons + InputAttachmentChips *@
@using SmallEBot.Components.Chat.Orchestration
@using SmallEBot.Components.Chat.Input
@using SmallEBot.Components.Chat.Dialogs
@using SmallEBot.Core.Models
@using SmallEBot.Models
@inject IWorkspaceService WorkspaceService
@inject ISkillsConfigService SkillsConfigService
@inject IDialogService DialogSvc
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit message</MudText>
    </TitleContent>
    <DialogContent>
        <div id="edit-message-dialog-input-wrap" class="position-relative">
            <div class="d-flex gap-1 mb-1">
                <MudIconButton Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" OnClick="@OpenAddFilesDialog" title="Add files" aria-label="Add files" />
                <MudIconButton Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" OnClick="@OpenAddSkillsDialog" title="Add skills" aria-label="Add skills" />
            </div>
            <InputAttachmentChips Orchestrator="@_orchestrator" />
            <MudTextField Value="@_orchestrator.InputText"
                          ValueChanged="@(async (string v) => await _orchestrator.HandleInputChangedAsync(v))"
                          Immediate="true"
                          Label="Message"
                          Placeholder="@("Plan or ask...")"
                          Variant="Variant.Outlined"
                          Lines="4"
                          Style="min-width: 400px" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save" Disabled="@string.IsNullOrWhiteSpace(_orchestrator.InputText)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string InitialContent { get; set; } = "";
    [Parameter] public IReadOnlyList<string> InitialAttachedPaths { get; set; } = [];
    [Parameter] public IReadOnlyList<string> InitialRequestedSkillIds { get; set; } = [];

    private InputOrchestrator _orchestrator = null!;

    protected override void OnInitialized()
    {
        _orchestrator = new InputOrchestrator(WorkspaceService, SkillsConfigService, uploadService: null);
        var attachments = InitialAttachedPaths.Select(p => new ResolvedPathAttachment(p)).Cast<AttachmentItem>();
        _orchestrator.InitializeFrom(InitialContent, attachments, InitialRequestedSkillIds);
        _orchestrator.OnStateChanged += StateHasChanged;
    }

    private async Task OpenAddFilesDialog()
    {
        var dialog = await DialogSvc.ShowAsync<AddFilesDialog>("Add files", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Data is List<string> paths)
            _orchestrator.AddFiles(paths);
    }

    private async Task OpenAddSkillsDialog()
    {
        var dialog = await DialogSvc.ShowAsync<AddSkillsDialog>("Add skills", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Data is List<string> skillIds)
            _orchestrator.AddSkills(skillIds);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(50);
                await JS.InvokeVoidAsync("SmallEBot.setChatInputCursorToEnd", "edit-message-dialog-input-wrap");
            }
            catch { /* ignore */ }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(new EditMessageResult(
        _orchestrator.InputText.Trim(),
        _orchestrator.Attachments.OfType<ResolvedPathAttachment>().Select(x => x.Path).ToList(),
        [.._orchestrator.RequestedSkillIds])));

    public void Dispose()
    {
        _orchestrator.OnStateChanged -= StateHasChanged;
    }
}
