@* Edit message dialog: uses InputOrchestrator + InputAttachmentPopover + InputAttachmentChips *@
@using SmallEBot.Components.Chat.Orchestration
@using SmallEBot.Components.Chat.Input
@using SmallEBot.Core.Models
@using SmallEBot.Models
@inject IWorkspaceService WorkspaceService
@inject ISkillsConfigService SkillsConfigService
@inject IJSRuntime JS
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit message</MudText>
    </TitleContent>
    <DialogContent>
        <div id="edit-message-dialog-input-wrap" class="position-relative">
            <InputAttachmentPopover Orchestrator="@_orchestrator" @ref="_popoverRef" />
            <InputAttachmentChips Orchestrator="@_orchestrator" />
            <MudTextField Value="@_orchestrator.InputText"
                          ValueChanged="@(async (string v) => await _orchestrator.HandleInputChangedAsync(v))"
                          Immediate="true"
                          Label="Message"
                          Placeholder="@("Use @ for files, / for skills")"
                          Variant="Variant.Outlined"
                          Lines="4"
                          Style="min-width: 400px" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save" Disabled="@string.IsNullOrWhiteSpace(_orchestrator.InputText)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string InitialContent { get; set; } = "";
    [Parameter] public IReadOnlyList<string> InitialAttachedPaths { get; set; } = [];
    [Parameter] public IReadOnlyList<string> InitialRequestedSkillIds { get; set; } = [];

    private InputOrchestrator _orchestrator = null!;
    private InputAttachmentPopover? _popoverRef;
    private DotNetObjectReference<EditMessageDialog>? _suggestionKeysDotNetRef;
    private bool _suggestionKeysAttached;
    private bool _prevPopoverOpen;

    protected override void OnInitialized()
    {
        _orchestrator = new InputOrchestrator(WorkspaceService, SkillsConfigService, uploadService: null);
        var attachments = InitialAttachedPaths.Select(p => new ResolvedPathAttachment(p)).Cast<AttachmentItem>();
        _orchestrator.InitializeFrom(InitialContent, attachments, InitialRequestedSkillIds);
        _orchestrator.OnStateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_orchestrator.IsPopoverOpen != _prevPopoverOpen)
        {
            _prevPopoverOpen = _orchestrator.IsPopoverOpen;
            if (_orchestrator.IsPopoverOpen && !_suggestionKeysAttached)
            {
                _suggestionKeysAttached = true;
                _suggestionKeysDotNetRef = DotNetObjectReference.Create(this);
                try
                {
                    await JS.InvokeVoidAsync("SmallEBot.attachChatInputSuggestionKeys", "edit-message-dialog-input-wrap", _suggestionKeysDotNetRef);
                }
                catch
                {
                    _suggestionKeysAttached = false;
                    _suggestionKeysDotNetRef?.Dispose();
                    _suggestionKeysDotNetRef = null;
                }
            }
            else if (!_orchestrator.IsPopoverOpen && _suggestionKeysAttached)
            {
                try { await JS.InvokeVoidAsync("SmallEBot.detachChatInputSuggestionKeys", "edit-message-dialog-input-wrap"); } catch { /* ignore */ }
                _suggestionKeysAttached = false;
                _suggestionKeysDotNetRef?.Dispose();
                _suggestionKeysDotNetRef = null;
            }
        }
    }

    [JSInvokable]
    public async Task OnSuggestionKeyDown(string key)
    {
        if (_popoverRef != null)
            await _popoverRef.HandleKeyFromInputAsync(key);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(new EditMessageResult(
        _orchestrator.InputText.Trim(),
        _orchestrator.Attachments.OfType<ResolvedPathAttachment>().Select(x => x.Path).ToList(),
        [.._orchestrator.RequestedSkillIds])));

    public void Dispose()
    {
        _orchestrator.OnStateChanged -= StateHasChanged;
        try { _ = JS.InvokeVoidAsync("SmallEBot.detachChatInputSuggestionKeys", "edit-message-dialog-input-wrap"); } catch { /* ignore */ }
        _suggestionKeysDotNetRef?.Dispose();
        _suggestionKeysDotNetRef = null;
    }
}
