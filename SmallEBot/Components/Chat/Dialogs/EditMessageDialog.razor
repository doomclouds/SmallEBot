<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit message</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_content" Lines="6" Variant="Variant.Outlined"
                      AutoFocus="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_content)"
                   OnClick="@Submit">Send</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string InitialContent { get; set; } = "";

    private string _content = "";

    protected override void OnInitialized() => _content = InitialContent;

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_content.Trim()));
}
