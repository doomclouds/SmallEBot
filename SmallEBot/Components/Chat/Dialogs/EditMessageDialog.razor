@using SmallEBot.Core
@using SmallEBot.Core.Models
@using SmallEBot.Components.Chat.Orchestration
@using SmallEBot.Components.Chat.Input
@inject IWorkspaceService WorkspaceService
@inject ISkillsConfigService SkillsConfigService
@inject IDialogService DialogSvc
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit message</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex gap-1 mb-1">
            <MudIconButton Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small"
                           OnClick="@OpenAddFilesDialog" title="Add files" />
            <MudIconButton Icon="@Icons.Material.Filled.Psychology" Size="Size.Small"
                           OnClick="@OpenAddSkillsDialog" title="Add skills" />
        </div>
        <InputAttachmentChips Orchestrator="@_orchestrator" />
        <MudTextField @bind-Value="_content" Lines="6" Variant="Variant.Outlined"
                      AutoFocus="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_content)"
                   OnClick="@Submit">Send</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string InitialContent { get; set; } = "";

    private string _content = "";
    private InputOrchestrator _orchestrator = null!;

    protected override void OnInitialized()
    {
        _orchestrator = new InputOrchestrator(WorkspaceService, SkillsConfigService);
        _orchestrator.OnStateChanged += StateHasChanged;

        var decoded = UserMessageCodec.Decode(InitialContent);
        _content = decoded.Text;

        if (decoded.Files.Count > 0)
            _orchestrator.AddFiles(decoded.Files);
        if (decoded.Skills.Count > 0)
            _orchestrator.AddSkills(decoded.Skills);
    }

    private async Task OpenAddFilesDialog()
    {
        var dialog = await DialogSvc.ShowAsync<AddFilesDialog>("Add files",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Data is List<string> paths)
            _orchestrator.AddFiles(paths);
    }

    private async Task OpenAddSkillsDialog()
    {
        var dialog = await DialogSvc.ShowAsync<AddSkillsDialog>("Add skills",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Data is List<string> skillIds)
            _orchestrator.AddSkills(skillIds);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var files = _orchestrator.Attachments.OfType<ResolvedPathAttachment>().Select(x => x.Path).ToList();
        var skills = _orchestrator.RequestedSkillIds.ToList();
        var encoded = UserMessageCodec.Encode(_content.Trim(), files, skills);
        MudDialog.Close(DialogResult.Ok(encoded));
    }

    public void Dispose()
    {
        _orchestrator.OnStateChanged -= StateHasChanged;
    }
}
