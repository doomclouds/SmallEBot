@using SmallEBot.Core

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit message</MudText>
    </TitleContent>
    <DialogContent>
        @if (_files.Count > 0 || _skills.Count > 0)
        {
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var file in _files)
                {
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                             Icon="@Icons.Material.Filled.AttachFile"
                             OnClose="@(() => _files.Remove(file))">@System.IO.Path.GetFileName(file)</MudChip>
                }
                @foreach (var skill in _skills)
                {
                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small"
                             Icon="@Icons.Material.Filled.AutoAwesome"
                             OnClose="@(() => _skills.Remove(skill))">@skill</MudChip>
                }
            </div>
        }
        <MudTextField @bind-Value="_content" Lines="6" Variant="Variant.Outlined"
                      AutoFocus="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_content)"
                   OnClick="@Submit">Send</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string InitialContent { get; set; } = "";

    private string _content = "";
    private List<string> _files = [];
    private List<string> _skills = [];

    protected override void OnInitialized()
    {
        var decoded = UserMessageCodec.Decode(InitialContent);
        _content = decoded.Text;
        _files = decoded.Files.ToList();
        _skills = decoded.Skills.ToList();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var encoded = UserMessageCodec.Encode(_content.Trim(), _files, _skills);
        MudDialog.Close(DialogResult.Ok(encoded));
    }
}
