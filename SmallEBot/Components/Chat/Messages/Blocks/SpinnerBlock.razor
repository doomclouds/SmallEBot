@using SmallEBot.Components.Chat.ViewModels.Blocks

<div class="mt-2 smallebot-spinner-wrap">
    <MudPaper Class="smallebot-spinner-block" Elevation="0">
        <div class="smallebot-spinner-line">
            <span class="smallebot-spinner-asterisk" style="color: @GetColor();">*</span>
            <span class="smallebot-spinner-text" style="color: @GetColor();">@GetCurrentVerb()…</span>
        </div>
    </MudPaper>
</div>

@code {
    [Parameter] public string[] Verbs { get; set; } = [];
    [Parameter] public TimeSpan Elapsed { get; set; }

    private const string ColorStart = "#e8a54a";
    private const string ColorEnd = "#8b0000";
    private const double ColorTransitionSeconds = 30;
    private const double VerbRotateSeconds = 10;

    private string GetCurrentVerb()
    {
        if (Verbs.Length == 0) return "Waiting";
        var slot = (int)(Elapsed.TotalSeconds / VerbRotateSeconds);
        var index = (slot * 31 + 7) % Verbs.Length;
        return Verbs[index];
    }

    private string GetColor()
    {
        var progress = Math.Min(1.0, (Elapsed.TotalSeconds % ColorTransitionSeconds) / ColorTransitionSeconds);
        return InterpolateColor(ColorStart, ColorEnd, progress);
    }

    private static string InterpolateColor(string hexStart, string hexEnd, double t)
    {
        var (r1, g1, b1) = ParseHex(hexStart);
        var (r2, g2, b2) = ParseHex(hexEnd);
        var r = (int)(r1 + (r2 - r1) * t);
        var g = (int)(g1 + (g2 - g1) * t);
        var b = (int)(b1 + (b2 - b1) * t);
        return $"rgb({r},{g},{b})";
    }

    private static (int r, int g, int b) ParseHex(string hex)
    {
        if (hex.StartsWith("#") && hex.Length == 7)
        {
            return (
                Convert.ToInt32(hex[1..3], 16),
                Convert.ToInt32(hex[3..5], 16),
                Convert.ToInt32(hex[5..7], 16)
            );
        }
        return (232, 165, 74);
    }
}
