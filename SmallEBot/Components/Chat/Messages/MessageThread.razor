@* CLI-style message thread: linear display, role prefixes, collapsible tool calls *@
@using SmallEBot.Components.Chat.Services
@using SmallEBot.Components.Chat.ViewModels.Blocks
@using SmallEBot.Components.Chat.Messages.Blocks
@using SmallEBot.Core
@using Microsoft.Extensions.AI
@inject IJSRuntime JS
@inject ChatPresentationService Presentation

<div @ref="_scrollRef" class="smallebot-chat-scroll">
    @{ var toolResults = ChatPresentationService.BuildToolResultsMap(Messages); }
    @for (var i = 0; i < Messages.Count; i++)
    {
        var msg = Messages[i];
        var idx = i;

        @if (msg.Role == ChatRole.User)
        {
            var decoded = UserMessageCodec.Decode(GetTextContent(msg));
            <div class="smallebot-cli-user">
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.caption" Class="smallebot-cli-role-user">● User</MudText>
                    @if (ShowRestartButtons)
                    {
                        <div class="d-flex">
                            @if (OnEditMessage.HasDelegate)
                            {
                                <MudTooltip Text="Edit & resend">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => OnEditMessage.InvokeAsync(idx))" />
                                </MudTooltip>
                            }
                            @if (OnRestartFromMessage.HasDelegate)
                            {
                                <MudTooltip Text="Resend from here">
                                    <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => OnRestartFromMessage.InvokeAsync(idx))" />
                                </MudTooltip>
                            }
                        </div>
                    }
                </div>
                @if (decoded.HasAttachments)
                {
                    <div class="d-flex flex-wrap gap-1 mt-1 mb-1">
                        @foreach (var file in decoded.Files)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.AttachFile">@System.IO.Path.GetFileName(file)</MudChip>
                        }
                        @foreach (var skill in decoded.Skills)
                        {
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.AutoAwesome">@skill</MudChip>
                        }
                    </div>
                }
                <div class="smallebot-cli-content">
                    <MarkdownBlock Content="@decoded.Text" />
                </div>
            </div>
        }
        else if (msg.Role == ChatRole.Assistant)
        {
            <div class="smallebot-cli-assistant">
                <MudText Typo="Typo.caption" Class="smallebot-cli-role-assistant">◆ Assistant</MudText>
                <div class="smallebot-cli-content">
                    @foreach (var block in Presentation.ConvertMessageToBlocks(msg, toolResults))
                    {
                        @switch (block)
                        {
                            case TextBlock text:
                                <MarkdownBlock Content="@text.Content" />
                                break;
                            case ToolCallBlockModel tool when ShowToolCalls:
                                <ToolCallBlock Model="@tool" />
                                break;
                            case ReasoningBlockModel reasoning:
                                <ReasoningBlock Content="@reasoning.Content" />
                                break;
                        }
                    }
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(PendingUserText))
    {
        var pendingDecoded = UserMessageCodec.Decode(PendingUserText);
        <div class="smallebot-cli-user">
            <MudText Typo="Typo.caption" Class="smallebot-cli-role-user">● User</MudText>
            @if (pendingDecoded.HasAttachments)
            {
                <div class="d-flex flex-wrap gap-1 mt-1 mb-1">
                    @foreach (var file in pendingDecoded.Files)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                                 Icon="@Icons.Material.Filled.AttachFile">@System.IO.Path.GetFileName(file)</MudChip>
                    }
                    @foreach (var skill in pendingDecoded.Skills)
                    {
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small"
                                 Icon="@Icons.Material.Filled.AutoAwesome">@skill</MudChip>
                    }
                </div>
            }
            <div class="smallebot-cli-content">
                <MarkdownBlock Content="@pendingDecoded.Text" />
            </div>
        </div>
    }

    @if (IsCompressing)
    {
        <div class="d-flex align-center ga-2 pa-3 mud-width-full">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                @CompressionMessage
            </MudText>
        </div>
    }

    @if (IsStreaming && StreamingBlocks.Count > 0)
    {
        <div class="smallebot-cli-assistant">
            <MudText Typo="Typo.caption" Class="smallebot-cli-role-assistant">◆ Assistant</MudText>
            <div class="smallebot-cli-content">
                @foreach (var block in GetStreamingBlocks())
                {
                    @switch (block)
                    {
                        case TextBlock text:
                            <MarkdownBlock Content="@text.Content" />
                            break;
                        case ToolCallBlockModel tool when ShowToolCalls:
                            <ToolCallBlock Model="@tool" OnCancel="@OnCancel" />
                            break;
                        case ReasoningBlockModel reasoning:
                            <ReasoningBlock Content="@reasoning.Content" />
                            break;
                        case WaitingBlockModel waiting:
                            <WaitingBlock Model="@waiting" OnCancel="@OnCancel" />
                            break;
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ChatMessage> Messages { get; set; } = [];
    [Parameter] public string? PendingUserText { get; set; }
    [Parameter] public IReadOnlyList<IBubbleBlock> StreamingBlocks { get; set; } = [];
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public bool IsCompressing { get; set; }
    [Parameter] public string CompressionMessage { get; set; } = "Compressing context...";
    [Parameter] public bool ShowWaitingForToolParams { get; set; }
    [Parameter] public TimeSpan WaitingElapsed { get; set; }
    [Parameter] public bool ShowToolCalls { get; set; } = true;
    [Parameter] public bool ShowRestartButtons { get; set; } = true;
    [Parameter] public EventCallback<int> OnRestartFromMessage { get; set; }
    [Parameter] public EventCallback<int> OnEditMessage { get; set; }
    [Parameter] public EventCallback<ApprovalBlockModel> OnApprove { get; set; }
    [Parameter] public EventCallback<ApprovalBlockModel> OnReject { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? ApprovalProcessingCallId { get; set; }

    private ElementReference _scrollRef;
    private bool _scrollToBottomRequested;

    public void RequestScrollToBottom() => _scrollToBottomRequested = true;

    public static string GetTextContent(ChatMessage msg)
    {
        if (msg.Text is { Length: > 0 } text) return text;
        var textParts = msg.Contents?.OfType<TextContent>().Select(t => t.Text).Where(t => !string.IsNullOrEmpty(t));
        return textParts != null ? string.Join("", textParts) : "";
    }

    private IReadOnlyList<IBubbleBlock> GetStreamingBlocks()
    {
        var list = ShowToolCalls ? StreamingBlocks.ToList() : StreamingBlocks.Where(b => b is not ToolCallBlockModel).ToList();
        list = list.Where(b => b is not ApprovalBlockModel a || a.State != ApprovalState.Pending).ToList();
        if (ShowWaitingForToolParams)
            list.Add(new WaitingBlockModel(WaitingElapsed));
        return list;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToBottomRequested)
        {
            _scrollToBottomRequested = false;
            try
            {
                await JS.InvokeVoidAsync("SmallEBot.scrollChatToBottom", _scrollRef);
            }
            catch { /* ignore if JS not loaded */ }
        }
    }
}
